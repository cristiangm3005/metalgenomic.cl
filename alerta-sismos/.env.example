# Copia este archivo como .env y completa lo que necesites.

# Tu ubicación (por defecto: Copiapó)
LAT=-27.3668
LON=-70.3314
LUGAR=Copiapó

# Reglas "RADIO_KM:MAGNITUD_MÍNIMA" separadas por coma.
# Se avisa si el sismo cumple CUALQUIERA de ellas. Ejemplo por defecto:
#   M3.5+ a menos de 100 km, M4.5+ a menos de 300 km,
#   M6.0+ a menos de 800 km, M7.0+ a menos de 2000 km (posible tsunami lejano)
REGLAS=100:3.5,300:4.5,800:6.0,2000:7.0

# Cada cuántos segundos consultar y cuántos minutos hacia atrás mirar
INTERVALO_S=60
VENTANA_MIN=60

# Fuentes: usgs, emsc (una o ambas)
FUENTES=usgs,emsc

# --- Telegram (opcional) ---
# 1. Habla con @BotFather, crea un bot y copia el token.
# 2. Escríbele cualquier cosa a tu bot y abre
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy.sh (opcional, push al celular sin crear cuenta) ---
# Instala la app ntfy (Android/iOS) y suscríbete al mismo tema.
# Usa un nombre difícil de adivinar: cualquiera que lo conozca puede leerlo.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
