# Copia como .env (en sismo-rt/backend) y ajusta.

# --- Fuentes ---
# emsc_ws  = WebSocket de EMSC (push en tiempo real, canal principal)
# usgs     = feed GeoJSON de USGS (respaldo y confirmación)
# emsc_rest= REST de EMSC, solo se activa si el WebSocket cae
FUENTES=emsc_ws,usgs,emsc_rest
USGS_INTERVALO_S=30
EMSC_REST_INTERVALO_S=30
EMSC_FALLBACK_TRAS_S=20

# --- Filtro por defecto (cada cliente puede enviar el suyo) ---
# Notificar si el sismo está a <= RADIO_KM  O  si su magnitud es >= MAG_GLOBAL
RADIO_KM=500
MAG_GLOBAL=6.0
# Nivel "alerta" (en vez de "info") si magnitud >= MAG_ALERTA y la intensidad estimada en tu sitio >= MMI_ALERTA
MAG_ALERTA=4.0
MMI_ALERTA=3.0
# Sismos que llegan con más antigüedad que esto no notifican (solo se ven en el mapa)
MAX_EDAD_ALERTA_MIN=30
MAG_MIN_MAPA=2.5

# Velocidades medias de onda (km/s)
VP_KM_S=6.5
VS_KM_S=3.75

# --- GlobalQuake / detector propio ---
# Token para POST /api/ingest. Vacío = endpoint deshabilitado.
# Genera uno con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# POST /api/simular para probar el cliente con sismos falsos. Desactívalo en producción.
SIMULACION=true

# Orígenes permitidos para el frontend (separados por coma). * = cualquiera.
CORS_ORIGENES=*

# --- Push al celular con ntfy para una ubicación fija (opcional) ---
# Instala la app ntfy y suscríbete a un tema difícil de adivinar.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
CASA_LAT=-27.3668
CASA_LON=-70.3314
CASA_NOMBRE=Copiapó

# --- GlobalQuake Server 0.11 (opcional) ---
# En GlobalQuake Server activa el servidor FDSNWS (autoStartFDSNWSEventServer=true, puerto 8080 por defecto).
# GLOBALQUAKE_URL=http://localhost:8080
GLOBALQUAKE_INTERVALO_S=5
